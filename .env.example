# ---------------------------------------------------------------------------
# Reelify environment file
# Copy to .env and adjust. Placeholder values only - never commit real secrets.
# Hostnames (db / redis / storage) match the docker-compose service names.
# ---------------------------------------------------------------------------

# --- Host ports (change any that clash with something else on your machine) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/reelify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelify

# --- Auth ---
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / workers ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible / MinIO in dev) ---
STORAGE_ENDPOINT=http://storage:9000
# Browser-facing endpoint for presigned download URLs (host-reachable).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=reelify-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
SIGNED_URL_TTL_SECONDS=3600
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Transcription ---
# Transcription: auto = OpenAI if TRANSCRIPTION_API_KEY is set, else local Whisper, else stub
TRANSCRIPTION_PROVIDER=auto
# OpenAI (or compatible) key; leave blank to use local Whisper
TRANSCRIPTION_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Local faster-whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# --- YouTube ingest (yt-dlp) ---

# --- YouTube ingest: cobalt (primary) + yt-dlp (fallback) ---
# Self-hosted cobalt API; the worker reaches the compose service at http://cobalt:9000
COBALT_API_URL=http://cobalt:9000
COBALT_API_KEY=
COBALT_VIDEO_QUALITY=1080

# Netscape cookies.txt for age-restricted / bot-flagged videos.
# Put the file in ./secrets/ (bind-mounted to /secrets in the worker).
YT_DLP_COOKIES_FILE=
YT_DLP_MAX_HEIGHT=1080
# JS-challenge solver (fetches code at runtime) — e.g. ejs:github
YT_DLP_REMOTE_COMPONENTS=ejs:github

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_STARTER=price_starter_placeholder
STRIPE_PRICE_ID_PRO=price_pro_placeholder

# --- Email ---
EMAIL_API_KEY=changeme-email-key
EMAIL_FROM=notifications@reelify.app

# --- Social publishing OAuth ---
TIKTOK_CLIENT_KEY=changeme
TIKTOK_CLIENT_SECRET=changeme
INSTAGRAM_CLIENT_ID=changeme
INSTAGRAM_CLIENT_SECRET=changeme
YOUTUBE_CLIENT_ID=changeme
YOUTUBE_CLIENT_SECRET=changeme
OAUTH_TOKEN_ENCRYPTION_KEY=nwwzyVL2Xc_UEi0VJxhfsuM75ngjaBHrBqEmdk1zBtA=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/social-accounts/callback

# --- Public URL ---
# On a real deployment set this to your canonical public origin, e.g.
#   PUBLIC_BASE_URL=https://reelify.example.com
# It is used for share links (/s/<slug>), OAuth redirects and Stripe URLs.
# Left empty, the app derives the origin from the request (X-Forwarded-*
# behind your reverse proxy) and falls back to FRONTEND_URL for local dev.
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=true

# --- Frontend ---
# Local-dev fallback origin (used only when PUBLIC_BASE_URL is empty and
# there is no request context). Match FRONTEND_PORT for local links.
FRONTEND_URL=http://localhost:3000
# VITE_API_URL=            # leave unset: app uses the relative /api path (nginx-proxied)
