# ---------------------------------------------------------------------------
# Reelify environment file
# Copy to .env and adjust. Placeholder values only - never commit real secrets.
# Hostnames (db / redis / storage) match the docker-compose service names.
# ---------------------------------------------------------------------------

# --- Host ports (change any that clash with something else on your machine) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/reelify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelify

# --- Auth ---
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / workers ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible / MinIO in dev) ---
STORAGE_ENDPOINT=http://storage:9000
# Browser-facing endpoint for presigned download URLs (host-reachable).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=reelify-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
SIGNED_URL_TTL_SECONDS=3600
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Transcription ---
TRANSCRIPTION_API_KEY=changeme-transcription-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_STARTER=price_starter_placeholder
STRIPE_PRICE_ID_PRO=price_pro_placeholder

# --- Email ---
EMAIL_API_KEY=changeme-email-key
EMAIL_FROM=notifications@reelify.app

# --- Social publishing OAuth ---
TIKTOK_CLIENT_KEY=changeme
TIKTOK_CLIENT_SECRET=changeme
INSTAGRAM_CLIENT_ID=changeme
INSTAGRAM_CLIENT_SECRET=changeme
YOUTUBE_CLIENT_ID=changeme
YOUTUBE_CLIENT_SECRET=changeme
OAUTH_TOKEN_ENCRYPTION_KEY=nwwzyVL2Xc_UEi0VJxhfsuM75ngjaBHrBqEmdk1zBtA=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/social-accounts/callback

# --- Frontend ---
# VITE_API_URL=            # leave unset: app uses the relative /api path (nginx-proxied)
